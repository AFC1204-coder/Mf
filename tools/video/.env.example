# Todo es opcional: sin este archivo el generador funciona con Edge TTS y la clave pública de la app.

# Gemini API (para la voz Gemini TTS). Sin clave, o si se agota la cuota, se usa Edge TTS.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Aoede

# Motor de voz por defecto: auto | gemini | edge | mudo
TTS_ENGINE=auto

# Edge TTS (gratuito, sin clave)
EDGE_VOICE=es-ES-AlvaroNeural

# Ruta de Chrome/Chromium si no está en el sitio habitual
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Supabase. El generador de vídeo usa por defecto el proyecto de la app con su clave pública de solo
# lectura; `tools/audio` (audiolibros) sí necesita que rellenes la clave aquí.
SUPABASE_URL=https://aduizdiiacrvpoavjmab.supabase.co
SUPABASE_ANON_KEY=
