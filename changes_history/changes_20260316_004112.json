    "content": "\n<!-- NOTIFICATION SYSTEM -->\n<style>\n.notif-bell{position:relative;font-size:1.1rem;padding:0.4rem 0.55rem !important;background:transparent !important;border:none !important;}\n.notif-bell:hover{background:var(--surface2) !important;}\n.notif-badge{position:absolute;top:2px;right:0;background:#ff4757;color:#fff;font-size:0.55rem;font-weight:800;min-width:16px;height:16px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 4px;font-family:var(--font-mono);animation:notifPulse 2s ease-in-out infinite;}\n@keyframes notifPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}\n.notif-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9998;opacity:0;visibility:hidden;transition:all 0.25s ease;}\n.notif-overlay.open{opacity:1;visibility:visible;}\n.notif-panel{position:fixed;top:0;right:-380px;width:380px;max-width:92vw;height:100vh;background:var(--bg);border-left:1px solid var(--border);z-index:9999;transition:right 0.3s cubic-bezier(0.22,1,0.36,1);display:flex;flex-direction:column;}\n.notif-panel.open{right:0;}\n.notif-header{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 1.4rem;border-bottom:1px solid var(--border);}\n.notif-header h3{margin:0;font-size:1rem;font-weight:700;color:var(--text);}\n.notif-header-actions{display:flex;gap:0.5rem;align-items:center;}\n.notif-mark-read{font-size:0.7rem;color:var(--accent);cursor:pointer;background:none;border:none;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.05em;}\n.notif-mark-read:hover{text-decoration:underline;}\n.notif-close{font-size:1.3rem;cursor:pointer;background:none;border:none;color:var(--text3);padding:0.2rem;line-height:1;}\n.notif-close:hover{color:var(--text);}\n.notif-list{flex:1;overflow-y:auto;padding:0.6rem;}\n.notif-empty{text-align:center;padding:3rem 1rem;color:var(--text3);font-size:0.85rem;}\n.notif-item{display:flex;gap:0.75rem;padding:0.85rem;border-radius:10px;margin-bottom:0.4rem;cursor:pointer;transition:background 0.15s;position:relative;}\n.notif-item:hover{background:var(--surface);}\n.notif-item.unread{background:var(--accent-bg);border:1px solid var(--accent)20;}\n.notif-item.unread::before{content:'';position:absolute;left:6px;top:50%;transform:translateY(-50%);width:6px;height:6px;border-radius:50%;background:var(--accent);}\n.notif-icon{font-size:1.5rem;flex-shrink:0;width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:var(--surface);}\n.notif-content{flex:1;min-width:0;}\n.notif-title{font-size:0.82rem;font-weight:600;color:var(--text);margin-bottom:2px;}\n.notif-msg{font-size:0.72rem;color:var(--text2);line-height:1.4;}\n.notif-time{font-size:0.6rem;color:var(--text3);font-family:var(--font-mono);margin-top:4px;}\n.achievement-toast{position:fixed;top:80px;right:20px;background:var(--bg);border:1px solid var(--accent);border-radius:14px;padding:1rem 1.4rem;display:flex;gap:0.8rem;align-items:center;z-index:10000;box-shadow:0 12px 40px rgba(0,0,0,0.4);transform:translateX(120%);transition:transform 0.4s cubic-bezier(0.22,1,0.36,1);max-width:340px;}\n.achievement-toast.show{transform:translateX(0);}\n.achievement-toast .ach-icon{font-size:2rem;}\n.achievement-toast .ach-title{font-size:0.8rem;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:0.06em;font-family:var(--font-mono);}\n.achievement-toast .ach-msg{font-size:0.78rem;color:var(--text2);margin-top:2px;line-height:1.35;}\n.push-banner{background:linear-gradient(135deg,var(--accent-bg),var(--surface));border:1px solid var(--accent)30;border-radius:12px;padding:1rem 1.2rem;margin:0.6rem;display:flex;gap:0.8rem;align-items:center;}\n.push-banner-text{flex:1;font-size:0.78rem;color:var(--text2);line-height:1.4;}\n.push-banner-btn{background:var(--accent);color:var(--bg);border:none;border-radius:8px;padding:0.5rem 1rem;font-size:0.72rem;font-weight:700;cursor:pointer;white-space:nowrap;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.05em;}\n.push-banner-btn:hover{filter:brightness(1.15);}\n.push-banner-dismiss{background:none;border:none;color:var(--text3);cursor:pointer;font-size:1rem;padding:0.2rem;}\n@media(max-width:700px){.notif-panel{width:100%;max-width:100vw;right:-100vw;}.achievement-toast{right:10px;left:10px;max-width:none;}}\n</style>\n<div class=\"notif-overlay\" id=\"notif-overlay\" onclick=\"toggleNotifPanel()\"></div>\n<div class=\"notif-panel\" id=\"notif-panel\">\n<div class=\"notif-header\"><h3>Notificaciones</h3><div class=\"notif-header-actions\"><button class=\"notif-mark-read\" onclick=\"markAllRead()\">Marcar leídas</button><button class=\"notif-close\" onclick=\"toggleNotifPanel()\">✕</button></div></div>\n<div id=\"push-banner-area\"></div>\n<div class=\"notif-list\" id=\"notif-list\"><div class=\"notif-empty\">Cargando...</div></div>\n</div>\n<div class=\"achievement-toast\" id=\"achievement-toast\"><div class=\"ach-icon\" id=\"ach-icon\">🏆</div><div class=\"ach-body\"><div class=\"ach-title\" id=\"ach-title\">Logro</div><div class=\"ach-msg\" id=\"ach-msg\"></div></div></div>\n<script>\nlet notifCache=[],notifPanelOpen=false,lastNotifCheck=0;\nfunction toggleNotifPanel(){notifPanelOpen=!notifPanelOpen;document.getElementById('notif-panel').classList.toggle('open',notifPanelOpen);document.getElementById('notif-overlay').classList.toggle('open',notifPanelOpen);if(notifPanelOpen){loadNotifications();checkPushPermission();}}\nasync function loadNotifications(){try{const d=await sb('notificaciones?usuario_id=eq.default&order=fecha.desc&limit=50');notifCache=d||[];renderNotifList();updateBadge();}catch(e){console.error('Notif load:',e);}}\nfunction renderNotifList(){const l=document.getElementById('notif-list');if(!notifCache.length){l.innerHTML='<div class=\"notif-empty\">Sin notificaciones todavía.<br>Completa lecciones y tests para desbloquear logros.</div>';return;}l.innerHTML=notifCache.map(n=>'<div class=\"notif-item '+(n.leida?'':'unread')+'\" onclick=\"markNotifRead(\\''+n.id+'\\',this)\"><div class=\"notif-icon\">'+(n.icono||'🔔')+'</div><div class=\"notif-content\"><div class=\"notif-title\">'+escH(n.titulo)+'</div><div class=\"notif-msg\">'+escH(n.mensaje)+'</div><div class=\"notif-time\">'+timeAgo(n.fecha)+'</div></div></div>').join('');}\nfunction updateBadge(){const u=notifCache.filter(n=>!n.leida).length;const b=document.getElementById('notif-badge');if(b){b.style.display=u>0?'flex':'none';b.textContent=u>9?'9+':u;}}\nasync function markNotifRead(id,el){if(el)el.classList.remove('unread');const n=notifCache.find(x=>x.id===id);if(n)n.leida=true;updateBadge();try{await fetch(SUPABASE_URL+'/rest/v1/notificaciones?id=eq.'+id,{method:'PATCH',headers:{'apikey':SUPABASE_KEY,'Authorization':'Bearer '+SUPABASE_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},body:JSON.stringify({leida:true})});}catch(e){}}\nasync function markAllRead(){notifCache.forEach(n=>n.leida=true);renderNotifList();updateBadge();try{await fetch(SUPABASE_URL+'/rest/v1/notificaciones?usuario_id=eq.default&leida=eq.false',{method:'PATCH',headers:{'apikey':SUPABASE_KEY,'Authorization':'Bearer '+SUPABASE_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},body:JSON.stringify({leida:true})});}catch(e){}}\nfunction timeAgo(ds){const d=new Date(ds),now=new Date(),s=Math.floor((now-d)/1000);if(s<60)return'ahora';if(s<3600)return Math.floor(s/60)+'min';if(s<86400)return Math.floor(s/3600)+'h';if(s<604800)return Math.floor(s/86400)+'d';return d.toLocaleDateString('es-ES',{day:'numeric',month:'short'});}\nfunction escH(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML;}\nfunction showAchievement(icon,title,msg){const t=document.getElementById('achievement-toast');document.getElementById('ach-icon').textContent=icon;document.getElementById('ach-title').textContent=title;document.getElementById('ach-msg').textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),5000);sendPushNotif(title,msg,icon);}\nasync function checkForNewNotifications(){const now=Date.now();if(now-lastNotifCheck<10000)return;lastNotifCheck=now;try{const d=await sb('notificaciones?usuario_id=eq.default&leida=eq.false&order=fecha.desc&limit=5');if(d&&d.length){const nw=d.filter(n=>!notifCache.find(c=>c.id===n.id));nw.forEach(n=>{showAchievement(n.icono||'🔔',n.titulo,n.mensaje);notifCache.unshift(n);});updateBadge();}}catch(e){}}\nasync function checkStreakAndRepasos(){try{const rR=await fetch(SUPABASE_URL+'/rest/v1/rpc/check_racha',{method:'POST',headers:{'apikey':SUPABASE_KEY,'Authorization':'Bearer '+SUPABASE_KEY,'Content-Type':'application/json'},body:JSON.stringify({p_usuario_id:'default'})});const racha=await rR.json();const rpR=await fetch(SUPABASE_URL+'/rest/v1/rpc/check_repaso_pendiente',{method:'POST',headers:{'apikey':SUPABASE_KEY,'Authorization':'Bearer '+SUPABASE_KEY,'Content-Type':'application/json'},body:JSON.stringify({p_usuario_id:'default'})});const repaso=await rpR.json();await loadNotifications();if(racha&&racha.alerta){setTimeout(()=>{const dias=racha.dias_sin_actividad;const ico=dias>=7?'💀':dias>=3?'⚠️':'🔥';showAchievement(ico,dias>=7?'Racha perdida':'Racha en riesgo',dias>=7?'Llevas '+dias+' días sin estudiar.':'Llevas '+dias+' días sin actividad. No pierdas tu racha.');},2000);}if(repaso&&repaso.pendientes>0){setTimeout(()=>{showAchievement('📋',repaso.pendientes+' repasos pendientes','El spacing effect maximiza la retención.');},racha&&racha.alerta?7000:2000);}}catch(e){console.error('Streak check:',e);}}\nfunction checkPushPermission(){const a=document.getElementById('push-banner-area');if(!('Notification' in window)||Notification.permission!=='default'){a.innerHTML='';return;}a.innerHTML='<div class=\"push-banner\"><div class=\"push-banner-text\">Activa notificaciones del navegador para alertas de racha y recordatorios de repaso.</div><button class=\"push-banner-btn\" onclick=\"reqPushPerm()\">Activar</button><button class=\"push-banner-dismiss\" onclick=\"this.parentElement.remove()\">✕</button></div>';}\nasync function reqPushPerm(){try{const p=await Notification.requestPermission();if(p==='granted'){toast('Notificaciones activadas ✓');document.getElementById('push-banner-area').innerHTML='';sendPushNotif('Notificaciones activas','Recibirás alertas de racha, repasos y logros.','🔔');}}catch(e){}}\nfunction sendPushNotif(title,body,icon){if(!('Notification' in window)||Notification.permission!=='granted')return;try{new Notification(title,{body:body,icon:'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><text y=\".9em\" font-size=\"90\">'+(icon||'🔔')+'</text></svg>',tag:'scs-'+Date.now()});}catch(e){}}\nwindow.addEventListener('DOMContentLoaded',()=>{setTimeout(checkStreakAndRepasos,1500);});\nsetInterval(()=>{if(!document.hidden)checkForNewNotifications();},60000);\n</script>\n"
  }
]
